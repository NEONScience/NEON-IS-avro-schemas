{
  "type": "record",
  "name": "windBuoy_speed_stats",
  "namespace": "org.neonscience.schema.dp01",
  "doc": "Buoy wind speed stats",
  "__version": "1.0",
  "fields": [
    {
      "name": "startDateTime",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Date and time at which a sampling is initiated (inclusive)"
    },
    {
      "name": "endDateTime",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Date and time at which a sampling is completed (exclusive)"
    },
    {
      "name": "buoyWindSpeedMean",
      "type": [
        "null",
        "float"
      ],
      "default": null,
      "doc": "Arithmetic mean of wind speed on buoy",
      "__neon_units": "metersPerSecond"
    },
    {
      "name": "buoyWindSpeedMinimum",
      "type": [
        "null",
        "float"
      ],
      "default": null,
      "doc": "Minimum wind speed on buoy",
      "__neon_units": "metersPerSecond"
    },
    {
      "name": "buoyWindSpeedMaximum",
      "type": [
        "null",
        "float"
      ],
      "default": null,
      "doc": "Maximum wind speed on buoy",
      "__neon_units": "metersPerSecond"
    },
    {
      "name": "buoyWindSpeedVariance",
      "type": [
        "null",
        "float"
      ],
      "default": null,
      "doc": "Variance in wind speed on buoy",
      "__neon_units": "metersPerSecond"
    },
    {
      "name": "buoyWindSpeedNumPts",
      "type": [
        "null",
        "int16"
      ],
      "default": null,
      "doc": "Number of points used to calculate the arithmetic mean of wind speed on buoy",
      "__neon_units": "number"
    },
    {
      "name": "buoyWindSpeedStdErMean",
      "type": [
        "null",
        "float"
      ],
      "default": null,
      "doc": "Standard error of the mean for wind speed on buoy",
      "__neon_units": "metersPerSecond"
    },
    {
      "name": "buoyWindSpeedExpUncert",
      "type": [
        "null",
        "float"
      ],
      "default": null,
      "doc": "Expanded uncertainty for wind speed on buoy",
      "__neon_units": "metersPerSecond"
    }
  ]
}
