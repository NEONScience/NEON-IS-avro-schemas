{
  "type": "record",
  "name": "stats_exo2",
  "namespace": "org.neonscience.schema.dp01",
  "doc": "L1 instantaneous statistics for exo2 sensor",
  "fields": [
    {
      "name": "startDateTime",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Date and time at which a sampling is initiated (inclusive)"
    },
    {
      "name": "endDateTime",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Date and time at which a sampling is completed (exclusive)"
    },
    {
      "name": "sensorDepth",
      "type": [
        "null",
        "float"
        ],
      "default": null,
      "doc": "Water depth of measurement",
      "__neon_units": "meter"
    },
    {
      "name": "sensorDepthExpUncert",
      "type": [
        "null",
        "float"
        ],
      "default": null,
      "doc": "Expanded uncertainty for sensor depth",
      "__neon_units": "meter"
    }
	]
}
