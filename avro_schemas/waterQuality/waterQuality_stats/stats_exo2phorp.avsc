{
  "type": "record",
  "name": "stats_exo2phorp",
  "namespace": "org.neonscience.schema.dp01",
  "doc": "L1 instantaneous statistics for exo2phorp sensor",
  "fields": [
    {
      "name": "startDateTime",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Date and time at which a sampling is initiated (inclusive)"
    },
    {
      "name": "endDateTime",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Date and time at which a sampling is completed (exclusive)"
    },
    {
      "name": "pH",
      "type": [
        "null",
        "float"
        ],
      "default": null,
      "doc": "Measurement of pH in sample",
      "__neon_units": "pH"
    },
    {
      "name": "pHExpUncert",
      "type": [
        "null",
        "float"
        ],
      "default": null,
      "doc": "Expanded uncertainty for pH",
      "__neon_units": "pH"
    }
	]
}
