{
  "type": "record",
  "name": "flags_logs_exodissolvedoxygen",
  "namespace": "org.neonscience.schema.dp0p",
  "doc": "Log data flags for exodissolvedoxygen sensor",
  "fields": [
    {
      "name": "readout_time",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Timestamp of readout expressed in milliseconds since epoch"
    },
    {
      "name": "dissolvedOxygenLogDataQF",
      "type": [
        "null",
        "int"
        ],
      "default": null,
      "doc": "Quality flag for dissolved oxygen concentration log data  (1=fail, 0=pass, -1=NA (i.e., could not be run))",
      "__neon_units": "NA"
    },
    {
      "name": "seaLevelDOSatLogDataQF",
      "type": [
        "null",
        "int"
        ],
      "default": null,
      "doc": "Quality flag for sea level dissolved oxygen saturation log data  (1=fail, 0=pass, -1=NA (i.e., could not be run))",
      "__neon_units": "NA"
    },
    {
      "name": "localDOSatLogDataQF",
      "type": [
        "null",
        "int"
        ],
      "default": null,
      "doc": "Quality flag for local dissolved oxygen saturation log data  (1=fail, 0=pass, -1=NA (i.e., could not be run))",
      "__neon_units": "NA"
    }
    ]
}
